{
  "name": "trust",
  "version": "0.0.1",
  "private": true,
  "description": "Caja negra auditable para agentes de IA",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "build": "nest build",
    "build:web": "pnpm --filter web build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "dev:web": "pnpm --filter web dev",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src/ --type-aware --max-warnings=0",
    "lint:fix": "oxlint src/ --type-aware --fix",
    "format": "oxfmt \"src/**/*.ts\"",
    "format:check": "oxfmt --check \"src/**/*.ts\"",
    "test": "vitest run"
  },
  "dependencies": {
    "@nestjs/common": "^12.2.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.2.0",
    "@nestjs/platform-express": "^12.2.0",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/serve-static": "^12.0.0",
    "@noble/post-quantum": "^0.7.1",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "viem": "^2.57.11",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.10",
    "@nestjs/testing": "^12.2.0",
    "@rspack/core": "^2.2.9",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2004",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "webpack-node-externals": "^3.0.0"
  }
}

{
  "name": "platanus-hack-26-ve-team-24",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "lint": "oxlint src/ --type-aware --max-warnings=0",
    "lint:fix": "oxlint src/ --type-aware --fix",
    "format": "oxfmt src/",
    "format:check": "oxfmt --check src/",
    "chain:sponsor": "tsx --conditions=react-server --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/chain/new-sponsor.mts",
    "chain:status": "tsx --conditions=react-server --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/chain/status.mts",
    "chain:compile": "tsx --conditions=react-server --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/chain/compile.mts",
    "chain:deploy": "tsx --conditions=react-server --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/chain/deploy.mts",
    "chain:deposit": "tsx --conditions=react-server --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/chain/deposit.mts",
    "chain:accredit": "tsx --conditions=react-server --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/chain/accredit.mts",
    "chain:spike": "tsx --conditions=react-server --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/chain/aa-spike.mts",
    "chain:identities": "tsx scripts/chain/identities.mts",
    "chain:seed": "tsx --conditions=react-server --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/chain/seed.mts",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "check:demo": "tsx --conditions=react-server --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/check-demo.mts"
  },
  "dependencies": {
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@sd-jwt/core": "^0.23.1",
    "jose": "^6.2.13",
    "next": "16.4.3",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "viem": "^2.57.10",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "prisma": "^7.10.1",
    "solc": "0.8.28",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
